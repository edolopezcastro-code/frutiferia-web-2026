{%- comment -%}
  Frutiferia — "Cómo llega tu pedido": pasos numerados + vías de entrega.

  Dos tipos de bloque:
  · paso    — un paso del proceso. La numeración la pone el bucle, así que
              reordenarlos en el editor renumera solo.
  · entrega — una vía de entrega (reparto a domicilio / retiro en el local).
              Van en un panel aparte al pie de los pasos.

  Es una sección genérica a propósito: sirve igual para explicar el proceso en
  la landing B2B o en la de bienestar. Nada del texto está hardcodeado.

  ⚠️ Todo lo que se escriba acá son días, horarios y umbrales de despacho: son
  promesas operativas. Cuando cambie la logística hay que cambiarlas también en
  el resto del tema (el umbral de $50.000 vive hardcodeado en ~15 lugares).

  Estilo, contraste y el porqué de cada decisión: ver el encabezado de
  assets/fru-proceso.css.
{%- endcomment -%}

{{ 'fru-proceso.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign heading_id = section.id | append: '-heading'

  assign pasos = section.blocks | where: 'type', 'paso'
  assign entregas = section.blocks | where: 'type', 'entrega'

  assign anchor_id = section.settings.anchor_id | default: 'como-llega' | handleize
-%}

<div
  class="fru-proceso{% if section.settings.full_width %} section--full-width{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}"
  id="{{ anchor_id }}"
>
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="fru-proceso__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fru-proceso__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="fru-proceso__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="fru-proceso__sub rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if pasos.size > 0 -%}
      <ol
        class="fru-proceso__steps"
        {% if section.settings.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% endif %}
      >
        {%- for block in pasos -%}
          <li class="fru-proceso__step" {{ block.shopify_attributes }}>
            <span class="fru-proceso__num" aria-hidden="true">
              {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="fru-proceso__step-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="fru-proceso__step-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if entregas.size > 0 -%}
      <ul class="fru-proceso__ways">
        {%- for block in entregas -%}
          <li class="fru-proceso__way" {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}
              <p class="fru-proceso__way-kicker">{{ block.settings.kicker | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="fru-proceso__way-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="fru-proceso__way-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="fru-proceso__way-link" href="{{ block.settings.link }}">
                {{- block.settings.link_label | escape }} &rarr;
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Proceso del pedido",
  "tag": "section",
  "class": "cc-fru-proceso",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "info": "Corto: se compone en Righteous, la fuente de marca.",
      "default": "Cómo funciona"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Cómo llega tu pedido"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Bajada"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Ancla de la sección",
      "info": "Para enlazar desde otra sección con #ancla. Por defecto: como-llega.",
      "default": "como-llega"
    },
    {
      "type": "header",
      "content": "Sección"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "white", "label": "Blanco" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del paso",
          "default": "Pides"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Explica el paso en una o dos frases.</p>"
        }
      ]
    },
    {
      "type": "entrega",
      "name": "Vía de entrega",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Antetítulo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Reparto a domicilio"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "info": "Días, zonas y umbrales: si cambian, cámbialos también en el resto del tema.",
          "default": "<p>Días, zonas y condiciones de despacho.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Proceso del pedido",
      "category": "Storytelling",
      "blocks": [
        { "type": "paso" },
        { "type": "paso" },
        { "type": "paso" },
        { "type": "paso" },
        { "type": "entrega" },
        { "type": "entrega" }
      ]
    }
  ]
}
{% endschema %}
