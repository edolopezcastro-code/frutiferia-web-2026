{%- comment -%}
  BELLA-3 (2026-08-27) — segundo layout "grid": 3 resenas SIMULTANEAS en escritorio,
  apiladas en movil. El carrusel original NO se toca (templates/page.b2b.json lo usa):
  se elige con el setting `layout`, cuyo default sigue siendo el slideshow.
  En modo grid no se descargan slideshow.css ni slideshow.js: la seccion deja de
  necesitar JS para mostrar su contenido.
{%- endcomment -%}

{%- assign is_grid = false -%}
{%- if section.settings.layout == 'grid' -%}{%- assign is_grid = true -%}{%- endif -%}

{%- if section.index > 2 -%}
  {%- unless is_grid -%}
    <link rel="stylesheet" href="{{ 'slideshow.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endunless -%}
  <link rel="stylesheet" href="{{ 'testimonials.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {%- unless is_grid -%}
    {{ 'slideshow.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}
  {{ 'testimonials.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.blocks.size > 1 and is_grid == false -%}
  <script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif
-%}

{%- style -%}
  {%- if section.settings.autoplay -%}
    #{{ section.id }} {
      --duration: {{ section.settings.autoplay_speed }}s;
      --play-state: paused;
    }
  {%- endif -%}

  #{{ section.id }} .testimonial-stars .rating__stars {
    --star-color: {{ section.settings.star_color.rgb }}
  }

  /* ==================================================================
     BELLA-3 — layout "grid": 3 resenas de Google simultaneas.
     Contraste calculado (no estimado), tarjeta blanca sobre banda lila
     --fru-morado-050 #F4F0F7:
       cita        --text  #1A1A1A sobre #FFF ......... 17,40:1  AAA
       autor/a     --text  #1A1A1A sobre #FFF ......... 17,40:1  AAA
       "Resena de Google" --text-muted #555 sobre #FFF .. 7,46:1  AAA
       inicial     #3A2E28 sobre el circulo #F4EFE9 ... 11,47:1  AAA
       enlace      --color-primary #671D90 sobre lila ... 8,66:1  AAA
     El circulo #F4EFE9 es DECORATIVO: la inicial repite el nombre que va
     al lado, asi que WCAG 1.4.11 (3:1) no aplica — igual lleva hairline
     para que se lea como ficha y no como mancha.
     ================================================================== */

  #{{ section.id }} .fru-reviews__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #{{ section.id }} .fru-review {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 24px 22px;
    background: var(--surface, #fff);
    border: 1px solid var(--border, rgba(103,29,144,.12));
    border-radius: var(--radius, 16px);
    text-align: start;
  }
  #{{ section.id }} .fru-review__stars { margin: 0; }
  #{{ section.id }} .fru-review__stars .rating__stars {
    --star-color: {{ section.settings.star_color.rgb }};
    font-size: 20px;
    letter-spacing: 2px;
  }
  #{{ section.id }} .fru-review__quote {
    flex: 1 1 auto;
    margin: 0;
    font-family: var(--font-body, inherit);
    font-size: 16px;
    line-height: 1.55;
    color: var(--text, #1A1A1A);
  }
  #{{ section.id }} .fru-review__quote > *:first-child { margin-top: 0; }
  #{{ section.id }} .fru-review__quote > *:last-child { margin-bottom: 0; }

  #{{ section.id }} .fru-review__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--border, rgba(103,29,144,.12));
  }
  #{{ section.id }} .fru-review__initial {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #F4EFE9;
    border: 1px solid #E4D9CC;
    font-family: var(--font-display, Georgia, serif);
    font-size: 19px;
    line-height: 1;
    color: #3A2E28;
  }
  #{{ section.id }} .fru-review__who { min-width: 0; display: block; }
  #{{ section.id }} .fru-review__name {
    display: block;
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text, #1A1A1A);
  }
  #{{ section.id }} .fru-review__source {
    display: block;
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 1.3;
    color: var(--text-muted, #555);
  }

  #{{ section.id }} .fru-reviews__foot {
    margin: 20px 0 0;
    text-align: center;
  }
  /* Tap target de 44px sin que el subrayado se despegue del texto: el alto lo
     da el padding del inline-flex y la linea la pone text-decoration, que
     sigue a la caja del texto y no al borde inferior de la caja del enlace. */
  #{{ section.id }} .fru-reviews__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 4px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-primary, #671D90);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  #{{ section.id }} .fru-reviews__link:hover,
  #{{ section.id }} .fru-reviews__link:focus-visible { text-decoration-thickness: 2px; }

  @media (min-width: 750px) {
    #{{ section.id }} .fru-reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    #{{ section.id }} .fru-review { padding: 28px 26px; }
    #{{ section.id }} .fru-review__quote { font-size: 16.5px; }
  }
{%- endstyle -%}

{%- if is_grid -%}

{%- assign grid_limit = section.settings.grid_limit | default: 3 -%}

<div class="section-{{ section.id }} section section--padded{% if section.settings.full_width %} section--full-width{% endif %}{% unless color_scheme == 'default' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} relative" id="{{ section.id }}"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__header">
        <h2 class="h4 {{ section.settings.text_align }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <ul class="fru-reviews__grid">
      {%- for block in section.blocks limit: grid_limit -%}
        {%- liquid
          assign author = block.settings.author | strip
          assign initial = author | slice: 0 | upcase
          assign source = block.settings.author_info | strip
          if section.settings.source_label != blank
            assign source = section.settings.source_label
          endif
        -%}
        <li class="fru-review" {{ block.shopify_attributes }}>
          {%- if block.settings.show_star_rating -%}
            <div class="fru-review__stars">
              <div class="rating inline-block align-middle" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.star_rating, rating_max: 5 }}">
                <span class="rating__stars" aria-hidden="true" style="--rating: {{ block.settings.star_rating }}; --rating-max: 5;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              </div>
            </div>
          {%- endif -%}

          <blockquote class="fru-review__quote rte">{{ block.settings.testimonial }}</blockquote>

          {%- if author != blank -%}
            <div class="fru-review__author">
              <span class="fru-review__initial" aria-hidden="true">{{ initial }}</span>
              <span class="fru-review__who">
                <span class="fru-review__name">{{ author | escape }}</span>
                {%- if source != blank -%}
                  <span class="fru-review__source">{{ source | escape }}</span>
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.reviews_link != blank and section.settings.reviews_link_label != blank -%}
      <p class="fru-reviews__foot">
        <a class="fru-reviews__link" href="{{ section.settings.reviews_link }}" target="_blank" rel="noopener nofollow">{{ section.settings.reviews_link_label | escape }}</a>
      </p>
    {%- endif -%}
  </div>
</div>

{%- else -%}

{%- unless section.settings.full_width -%}
  <div class="container">
{%- endunless -%}

<div class="section-{{ section.id }} section{% unless bg_color == false %} section--padded{% if section.settings.full_width %} section--full-width{% endif %}{% endunless %}{% unless color_scheme == 'default' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} relative" id="{{ section.id }}"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
  <div class="container md:flex {{ section.settings.text_position }}">
    <div class="testimonial-max-w-{{ section.settings.testimonial_size }}">
      {%- if section.settings.heading != blank -%}
        <div class="section__header">
          <h2 class="h4 {{ section.settings.text_align }}">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}

      <slide-show class="testimonials block overflow-hidden" role="region" aria-roledescription="{{ 'sections.slideshow.carousel' | t }}" aria-label="{{ 'sections.testimonials.title' | t }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}" data-transition="{{ section.settings.transition }}">
        <div class="slideshow flex relative" id="slideshow-{{ section.id }}" aria-live="polite" aria-atomic="true" tabindex="0">
          {%- for block in section.blocks -%}
            <div class="slideshow__slide{% if forloop.first %} is-active{% endif %}{% if forloop.length == 1 %} testimonials__slide--no-padding{% endif %} w-full"
                 role="group" aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                 aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                 {%- unless forloop.first %}tabindex="-1"{% endunless %}
                 {%- if request.design_mode %}data-index="{{ forloop.index0 }}"{% endif %}
                 {{ block.shopify_attributes }}>
              <figure class="testimonial m-0 has-motion">
                {%- if block.settings.testimonial != blank -%}
                  {%- if block.settings.show_star_rating -%}
                    <div class="testimonial-stars text-{{ section.settings.testimonial_size }} {{ section.settings.text_align }}">
                      <div class="rating inline-block align-middle" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.star_rating, rating_max: 5 }}">
                        <span class="rating__stars" aria-hidden="true" style="--rating: {{ block.settings.star_rating }}; --rating-max: 5;">★★★★★</span>
                      </div>
                    </div>
                  {%- endif -%}

                  <blockquote class="testimonial__quote{% if block.settings.author != blank or block.settings.author_image != blank %} testimonial__quote-padded{% endif %} {% if section.settings.testimonial_font == 'heading' %} font-heading{% endif %} text-{{ section.settings.testimonial_size }} rte{% if section.settings.show_quotes %} testimonial__quote--with-mark{% endif %} {{ section.settings.text_align }} m-0">
                    {{ block.settings.testimonial }}
                  </blockquote>

                  {%- if block.settings.author != blank or block.settings.author_image != blank -%}
                    <div class="testimonial__author flex items-center {{ section.settings.text_align }}">
                      {%- if block.settings.author_image != blank and section.settings.nav_style != 'author_images' or section.blocks.size == 1 -%}
                        <div class="testimonial__author-image overflow-hidden shrink-0">
                          <div class="media relative" style="padding-top: 100%;">
                            {% render 'image',
                              image: block.settings.author_image,
                              src_width: 48,
                              srcset_2x: true,
                              lazy_load: false,
                              class: 'img-fit'
                            %}
                          </div>
                        </div>
                      {%- endif -%}

                      <div class="testimonial__author-text {{ section.settings.text_align }}{% if section.settings.nav_style == 'author_images' and section.blocks.size > 1 %} text-center{% elsif block.settings.author_image != blank %} text-start{% endif %}">
                        <p class="font-bold mb-0">{{ block.settings.author | escape }}</p>
                        <p class="mb-0">{{ block.settings.author_info | escape }}</p>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </figure>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="container flex justify-center w-full pointer-events-none no-js-hidden">
            {%- if section.settings.nav_style == 'slideshow_nav_dots' or section.settings.nav_style == 'slideshow_nav_lines' -%}
              <div class="slideshow-pagination flex flex-wrap justify-center items-center">
                {%- for block in section.blocks -%}
                  <button class="page-btn" data-index="{{ forloop.index0 }}" aria-controls="slideshow-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}>
                    <span class="visually-hidden">{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}</span>
                    {%- if section.settings.nav_style == 'slideshow_nav_lines' -%}
                      <span class="page-btn__line block relative overflow-hidden pointer-events-none"></span>
                    {%- else -%}
                      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" class="page-btn__circle block pointer-events-none">
                        <circle class="page-btn__fg-circle" cx="15" cy="15" r="3.5" />
                        <circle class="page-btn__bg-circle" cx="15" cy="15" r="6" />
                      </svg>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if section.settings.nav_style == 'author_images' and section.blocks.size > 1 -%}
              <div class="slideshow-pagination flex flex-wrap justify-center items-center">
                {%- for block in section.blocks -%}
                  {%- if block.settings.author_image != blank -%}
                    <button class="page-btn page-btn--author-images" data-index="{{ forloop.index0 }}" aria-controls="slideshow-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}>
                      <img src="{{ block.settings.author_image | image_url: width: 80, height: 80, crop: 'center' }}" class="testimonial__author-image pointer-events-none" alt="{{ block.settings.author_image.alt }}" loading="lazy" width="40" height="40"/>
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if section.settings.nav_style == 'arrows' or section.settings.autoplay -%}
              <div class="slideshow-nav flex items-center">
                {%- if section.settings.nav_style == 'arrows' -%}
                  <button type="button" class="slideshow-nav__btn btn hidden md:block has-ltr-icon" name="prev" aria-controls="slideshow-{{ section.id }}">
                    <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                    {% render 'icon-chevron-left' %}
                  </button>

                  <div class="slideshow-nav__counter">
                    <span class="slideshow-nav__counter-current">1</span>
                    <span aria-hidden="true"> / </span>
                    <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                    <span class="slideshow-nav__counter-total">{{ section.blocks.size }}</span>
                  </div>
                {%- endif -%}

                {%- if section.settings.autoplay -%}
                  <div class="slideshow-nav__autoplay flex items-center {% unless section.settings.slider_pause %}hidden{% endunless %}">
                    <button type="button" class="slideshow-nav__btn autoplay-btn btn">
                      <span class="pause-icon block pointer-events-none">
                        <span class="visually-hidden">{{ 'sections.slideshow.pause' | t }}</span>
                        {% render 'icon-pause' %}
                      </span>
                      <span class="play-icon block pointer-events-none">
                        <span class="visually-hidden">{{ 'sections.slideshow.play' | t }}</span>
                        {% render 'icon-video' %}
                      </span>
                    </button>
                  </div>
                {%- endif -%}

                {%- if section.settings.nav_style == 'arrows' -%}
                  <button type="button" class="slideshow-nav__btn btn hidden md:block has-ltr-icon" name="next" aria-controls="slideshow-{{ section.id }}">
                    <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                    {% render 'icon-chevron-right' %}
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </slide-show>
    </div>
  </div>
</div>

{%- unless section.settings.full_width -%}
  </div>
{%- endunless -%}

{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "cc-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Testimonials"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "\"Grid\" shows several reviews at once (3 across on desktop, stacked on mobile) and loads no slideshow JS.",
      "options": [
        { "value": "slideshow", "label": "Slideshow (one at a time)" },
        { "value": "grid", "label": "Grid (all at once)" }
      ],
      "default": "slideshow"
    },
    {
      "visible_if": "{{ section.settings.layout == 'grid' }}",
      "type": "range",
      "id": "grid_limit",
      "label": "Reviews shown in the grid",
      "info": "The remaining blocks stay saved in the section, ready to rotate in.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "visible_if": "{{ section.settings.layout == 'grid' }}",
      "type": "text",
      "id": "source_label",
      "label": "Source line under each name",
      "info": "Leave blank to keep each block's own \"Location or other information\".",
      "default": "Rese\u00f1a de Google"
    },
    {
      "visible_if": "{{ section.settings.layout == 'grid' }}",
      "type": "url",
      "id": "reviews_link",
      "label": "Link to all reviews"
    },
    {
      "visible_if": "{{ section.settings.layout == 'grid' }}",
      "type": "text",
      "id": "reviews_link_label",
      "label": "Link text",
      "default": "Lee nuestras rese\u00f1as en Google \u2192"
    },
    {
      "type": "checkbox",
      "id": "show_quotes",
      "label": "Show quote marks above each testimonial",
      "default": false
    },
    {
      "type": "select",
      "id": "testimonial_size",
      "label": "Text size",
      "options": [
        {
          "value": "h6",
          "label": "Extra extra small"
        },
        {
          "value": "h5",
          "label": "Extra small"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h1",
          "label": "Extra large"
        },
        {
          "value": "h0",
          "label": "Extra extra large"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "testimonial_font",
      "label": "Testimonial font",
      "options": [
        {
          "label": "Body font",
          "value": "body"
        },
        {
          "label": "Heading font",
          "value": "heading"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        {
          "value": "justify-start",
          "label": "Left"
        },
        {
          "value": "justify-center",
          "label": "Center"
        },
        {
          "value": "justify-end",
          "label": "Right"
        }
      ],
      "default": "justify-center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "text-start justify-start",
          "label": "Left"
        },
        {
          "value": "text-center justify-center",
          "label": "Center"
        },
        {
          "value": "text-end justify-end",
          "label": "Right"
        }
      ],
      "default": "text-center justify-center"
    },
    {
      "type": "header",
      "content": "Slideshow appearance"
    },
    {
      "type": "select",
      "id": "nav_style",
      "label": "Pagination style",
      "info": "When using \"Author images\", author images must be set for all blocks.",
      "options": [
        {
          "value": "arrows",
          "label": "Arrows"
        },
        {
          "value": "slideshow_nav_dots",
          "label": "Dots"
        },
        {
          "value": "author_images",
          "label": "Author images"
        }
      ],
      "default": "slideshow_nav_dots"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition",
      "options": [
        {
          "value": "slide-fade",
          "label": "Slide and fade"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "slide-fade"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate testimonials",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.autoplay }}",
      "type": "checkbox",
      "id": "slider_pause",
      "label": "Show pause button",
      "info": "Only applies when auto-rotate is turned on.",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.autoplay }}",
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change testimonials every",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "Scheme 1"
        },
        {
          "value": "2",
          "label": "Scheme 2"
        },
        {
          "value": "3",
          "label": "Scheme 3"
        }
      ],
      "default": "1"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Rating stars",
      "default": "#f7c346"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section background full width",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "testimonial",
