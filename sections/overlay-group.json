{
  "type": "aside",
  "name": "Overlay group",
  "sections": {
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "show_cart_page_link": false,
        "show_backorder_text": true,
        "show_vendor": true,
        "position_cart_summary": "top",
        "stick_footer": true,
        "stick_footer_mobile": true,
        "show_order_note": true,
        "show_shipping_text_notice": true,
        "show_additional_checkout_buttons": true,
        "enable_empty_cart": true,
        "enable_empty_cart_mobile": true,
        "show_checkout_button": true,
        "cart_terms_page": "",
        "show_shipping_calculator": true,
        "shipping_calculator_default_country": "Chile",
        "promoted_products_visibility": "always",
        "promoted_products_heading": "¿Te falta algo?",
        "promoted_products_list": [],
        "promoted_products_layout": "carousel",
        "show_media_promotion": true,
        "media_promotion_visibility": "below_threshold",
        "link_url": "shopify://collections/all",
        "media_promotion_min_height": 100,
        "content": "<p><strong>¡Envío gratis sobre $30.000!</strong> Agrega más productos y ahorra en despacho.</p>",
        "text_type_scale": "1em",
        "text_width": 400,
        "text_alignment": "justify-center items-center text-center",
        "button_label": "Seguir comprando",
        "button_style": "btn btn--primary",
        "text_color": "#ffffff",
        "tint_color": "#2e7d32",
        "tint_opacity": 80
      }
    },
    "product-compare": {
      "type": "product-compare",
      "blocks": {
        "compare-1": {
          "type": "image",
          "settings": {
            "show_line": false
          }
        },
        "compare-2": {
          "type": "vendor",
          "settings": {
            "show_line": false
          }
        },
        "compare-3": {
          "type": "title",
          "settings": {
            "show_line": false
          }
        },
        "compare-4": {
          "type": "price",
          "settings": {
            "show_line": false
          }
        },
        "compare-5": {
          "type": "description",
          "settings": {
            "truncate_description": false,
            "words_to_show": 20,
            "show_line": false
          }
        },
        "compare-6": {
          "type": "variants",
          "settings": {
            "show_line": false
          }
        }
      },
      "block_order": [
        "compare-1",
        "compare-2",
        "compare-3",
        "compare-4",
        "compare-5",
        "compare-6"
      ],
      "settings": {}
    }
  },
  "order": [
    "cart-drawer",
    "product-compare"
  ]
}
