{%- liquid
  assign embed_url = section.settings.embed_url | default: 'https://menu-frutiferia.com/'
  assign h_desktop = section.settings.height_desktop | default: 900
  assign h_mobile = section.settings.height_mobile | default: 720
-%}

<style>
  #{{ section.id }} .frutimenu-embed__frame-wrap {
    position: relative;
    width: 100%;
    height: {{ h_mobile }}px;
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    background: #f2f4f3;
  }
  #{{ section.id }} .frutimenu-embed__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  @media (min-width: 750px) {
    #{{ section.id }} .frutimenu-embed__frame-wrap {
      height: {{ h_desktop }}px;
    }
  }
  #{{ section.id }} .frutimenu-embed__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
</style>

<div
  id="{{ section.id }}"
  class="section section--full-width{% unless section.settings.section_height == 'tight' %} section--padded-{{ section.settings.section_height }}{% endunless %}"
>
  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

    <div id="frutimenu-app" class="frutimenu-embed">
      {%- if section.settings.heading != blank or section.settings.show_fullscreen_button -%}
        <div class="frutimenu-embed__bar">
          {%- if section.settings.heading != blank -%}
            <h2 class="h3" style="margin:0;">{{ section.settings.heading }}</h2>
          {%- else -%}
            <span></span>
          {%- endif -%}
          {%- if section.settings.show_fullscreen_button -%}
            <a
              href="{{ embed_url }}"
              target="_blank"
              rel="noopener"
              class="btn btn--secondary btn--sm"
            >{{ section.settings.fullscreen_label | default: 'Abrir en pantalla completa' }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="frutimenu-embed__frame-wrap">
        <iframe
          class="frutimenu-embed__frame"
          src="{{ embed_url }}"
          title="{{ section.settings.iframe_title | default: 'FrutiMenu - planifica tu semana' | escape }}"
          loading="lazy"
          allow="clipboard-write; clipboard-read; fullscreen; encrypted-media"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "FrutiMenu (embed)",
  "tag": "section",
  "class": "cc-frutimenu-embed",
  "settings": [
    {
      "type": "url",
      "id": "embed_url",
      "label": "URL de la app",
      "info": "Dirección de FrutiMenu en Lovable (o el subdominio menu.frutiferia.com cuando lo tengas)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título sobre la app",
      "default": "Arma tu semana"
    },
    {
      "type": "header",
      "content": "Alto del marco"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Alto en escritorio (px)",
      "min": 500,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Alto en móvil (px)",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Esquinas redondeadas",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Botón de respaldo"
    },
    {
      "type": "checkbox",
      "id": "show_fullscreen_button",
      "label": "Mostrar botón 'Abrir en pantalla completa'",
      "default": true
    },
    {
      "type": "text",
      "id": "fullscreen_label",
      "label": "Texto del botón",
      "default": "Abrir en pantalla completa"
    },
    {
      "type": "text",
      "id": "iframe_title",
      "label": "Título accesible del marco",
      "default": "FrutiMenu - planifica tu semana"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Sección a todo el ancho",
      "default": false
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Espaciado de la sección",
      "options": [
        { "value": "tight", "label": "Sin espacio" },
        { "value": "xsmall", "label": "Extra pequeño" },
        { "value": "small", "label": "Pequeño" },
        { "value": "medium", "label": "Medio" },
        { "value": "default", "label": "Normal" }
      ],
      "default": "small"
    }
  ],
  "presets": [
    {
      "name": "FrutiMenu (embed)",
      "category": "Advanced"
    }
  ],
  "disabled_on": {
    "groups": ["aside"]
  }
}
{% endschema %}
