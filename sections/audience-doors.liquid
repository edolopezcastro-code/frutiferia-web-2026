{%- comment -%}
  Frutiferia Web 4.0 — Selector de audiencia "3 puertas" (WS-3).
  Tres tarjetas paralelas y simetricas (Hogares / Negocios / Bienestar laboral) con
  color de canal (celeste / violeta / rose). Da, en el primer pantallazo, una ruta
  clara a cada uno de los 3 publicos del negocio. Cada puerta es una tarjeta clickeable.
{%- endcomment -%}

{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}

<style>
  #{{ section.id }} .audience-doors__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 750px) {
    #{{ section.id }} .audience-doors__grid {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, 1fr);
      gap: 24px;
    }
  }
  #{{ section.id }} .audience-door {
    --door-accent: #671D90;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid rgba(20, 8, 30, 0.08);
    border-top: 4px solid var(--door-accent);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 2px rgba(20, 8, 30, 0.04);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    height: 100%;
  }
  #{{ section.id }} .audience-door:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(20, 8, 30, 0.12);
  }
  #{{ section.id }} .audience-door__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: color-mix(in srgb, var(--door-accent) 10%, #ffffff);
  }
  #{{ section.id }} .audience-door__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #{{ section.id }} .audience-door__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 34px 32px 36px;
    flex: 1 1 auto;
  }
  #{{ section.id }} .audience-door__eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--door-accent);
    color: color-mix(in srgb, var(--door-accent), #000 24%);
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  #{{ section.id }} .audience-door__eyebrow::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--door-accent);
    flex: 0 0 auto;
  }
  #{{ section.id }} .audience-door__title {
    margin: 0;
    line-height: 1.12;
    font-size: 1.75rem;
  }
  #{{ section.id }} .audience-door__text {
    margin: 0;
    color: rgba(20, 8, 30, 0.74);
    font-size: 1.08rem;
    line-height: 1.55;
    flex: 1 1 auto;
  }
  #{{ section.id }} .audience-door__cta {
    margin-top: 18px;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--door-accent);
    background: color-mix(in srgb, var(--door-accent), #000 24%);
    color: #ffffff;
    font-weight: 600;
    font-size: 1.05rem;
    padding: 14px 26px;
    border-radius: 999px;
    transition: filter 0.18s ease, gap 0.18s ease;
  }
  @media (max-width: 749px) {
    #{{ section.id }} .audience-door__body { padding: 26px 24px 28px; gap: 12px; }
    #{{ section.id }} .audience-door__title { font-size: 1.5rem; }
    #{{ section.id }} .audience-door__text { font-size: 1rem; }
    #{{ section.id }} .audience-door__cta {
      width: 100%;
      justify-content: center;
      min-height: 52px;
      padding: 16px 24px;
      font-size: 1.08rem;
    }
  }
  #{{ section.id }} .audience-door:hover .audience-door__cta {
    filter: brightness(0.92);
    gap: 12px;
  }
</style>

<div
  class="section section--padded{% if section.settings.full_width %} section--full-width{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}"
  id="{{ section.id }}"
  {% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %}data-cc-animate{% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section__header text-center" style="margin-bottom: 28px;">
        {%- if section.settings.subheading != blank -%}
          <p class="subheading" style="margin-bottom: 6px;">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h3 mb-0">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="audience-doors__grid">
      {%- for block in section.blocks -%}
        <a
          class="audience-door"
          href="{{ block.settings.cta_link | default: '#' }}"
          style="--door-accent: {{ block.settings.accent | default: '#671D90' }};"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="audience-door__media">
              {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '360, 540, 720, 1080' }}
            </div>
          {%- endif -%}
          <div class="audience-door__body">
            {%- if block.settings.eyebrow != blank -%}
              <span class="audience-door__eyebrow">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="audience-door__title h5">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="audience-door__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <span class="audience-door__cta">{{ block.settings.cta_label }} <span aria-hidden="true">&rarr;</span></span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Selector de audiencia",
  "tag": "section",
  "class": "cc-audience-doors",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Frutiferia para cada quien"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Cómo te abasteces con Frutiferia?"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "none", "label": "Ninguno (transparente)" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "prevent_animation",
      "label": "Desactivar animación de entrada",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "door",
      "name": "Puerta",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Etiqueta (eyebrow)",
          "default": "Para tu casa"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Tu semana resuelta"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Frutas y verduras frescas a tu puerta, y FrutiMenu que arma tu menú de 7 días y la lista de compra en un minuto.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Texto del botón",
          "default": "Arma tu semana"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Enlace del botón"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Color de canal",
          "default": "#671D90"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Selector de audiencia (3 puertas)",
      "blocks": [
        {
          "type": "door",
          "settings": {
            "eyebrow": "Para tu casa",
            "title": "Tu semana resuelta",
            "text": "<p>Frutas y verduras frescas a tu puerta, y FrutiMenu que arma tu menú de 7 días y la lista de compra en un minuto.</p>",
            "cta_label": "Arma tu semana",
            "cta_link": "shopify://pages/frutimenu",
            "accent": "#2C9CDB"
          }
        },
        {
          "type": "door",
          "settings": {
            "eyebrow": "Para tu negocio",
            "title": "Abastecimiento sin quiebres",
            "text": "<p>Restaurantes, hoteles y cafeterías: calidad pareja, despacho programado y factura al día. Cotización en menos de 24 h.</p>",
            "cta_label": "Cotiza para tu negocio",
            "cta_link": "shopify://pages/venta-a-negocios",
            "accent": "#671D90"
          }
        },
        {
          "type": "door",
          "settings": {
            "eyebrow": "Para tu equipo",
            "title": "Bienestar que se nota",
            "text": "<p>Cajas de fruta para colaboradores, charlas de bienestar e informes para RRHH. Equipos más sanos, más presentes.</p>",
            "cta_label": "Fruta para tu equipo",
            "cta_link": "shopify://pages/bienestar",
            "accent": "#D6457D"
          }
        }
      ]
    }
  ]
}
{% endschema %}
