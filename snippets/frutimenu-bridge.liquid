{%- comment -%}
  Puente FrutiMenu -> carrito nativo de Canopy (F1-5, camino B).

  La app "Mi Menú Semanal" (mi-frutimenu) vive en un iframe cross-origin dentro de la
  sección cc-frutimenu-embed. Al apretar "Comprar", la app hace postMessage con los
  ítems del carrito. Este puente los agrega vía /cart/add.js, fija el cupón y abre el
  drawer de Canopy — SIN navegar, SIN pestaña nueva, SIN saltar a checkout.

  Contrato del mensaje (app -> tema), origin === embed_url:
    { type:"frutimenu:add-to-cart", nonce, items:[{variantId, quantity}], discount, fallbackUrl }
  Respuesta (tema -> app): { type:"frutimenu:cart-ok", nonce }  (ack: "lo manejo nativo").
  El nonce se ecoa tal cual (FM-4.1, mi-frutimenu): la app lo usa para descartar acks
  de un intento viejo (doble-click) en vez de resolver el intento equivocado.

  Robustez:
    - CR-10: apretar "Comprar" de nuevo REEMPLAZA lo del menú, no lo suma. Cada línea
      que pone el menú va marcada con la propiedad oculta `_menu` y se vacía antes de
      agregar la tanda nueva. Lo que la persona agregó a mano queda intacto.
    - Origen estricto (solo el del iframe) + saneo de ids/cantidades: nadie más puede
      empujar al carrito desde otra pestaña/origen.
    - El ack se manda AL RECIBIR (no al terminar) para frenar el fallback de la app
      aunque el add tarde en móvil. Si el add falla, el tema navega al fallbackUrl
      (mismo destino que el fallback de la app) → nunca queda colgado.

  Params: section_id (string), embed_url (string)
{%- endcomment -%}
<script>
  (function () {
    var SECTION_ID = {{ section_id | json }};
    var EMBED_URL = {{ embed_url | json }};
    var ALLOWED;
    try { ALLOWED = new URL(EMBED_URL, window.location.origin).origin; }
    catch (e) { ALLOWED = "https://menu.frutiferia.com"; }

    var REQUEST = "frutimenu:add-to-cart";
    var ACK = "frutimenu:cart-ok";
    var TRACK = "frutimenu:track";

    function iframeEl() {
      var sec = document.getElementById(SECTION_ID);
      return sec ? sec.querySelector(".frutimenu-embed__frame") : null;
    }

    function ack(nonce) {
      var f = iframeEl();
      var msg = { type: ACK };
      if (typeof nonce === "string") msg.nonce = nonce;
      if (f && f.contentWindow) f.contentWindow.postMessage(msg, ALLOWED);
    }

    // Cada línea que pone el menú viaja marcada con esta propiedad oculta (el guion
    // bajo la esconde en el carrito y en el correo de confirmación). Es lo que nos
    // deja distinguir "esto lo puso el menú" de "esto lo agregó la persona a mano".
    var MARCA_MENU = "_menu";

    /**
     * CR-10 — Vacía lo que el menú había dejado antes de volver a agregar.
     *
     * Por qué: /cart/add.js SUMA. Sin esto, volver al menú, cambiar algo y apretar
     * "Comprar" de nuevo dejaba el carrito con las dos versiones encima (la persona
     * veía el doble de todo y tenía que corregir a mano, o pagaba de más).
     *
     * Solo toca líneas con la marca del menú: lo que la persona agregó por su cuenta
     * (por ejemplo desde la franja "Sigue sumando") se queda intacto.
     *
     * Best-effort a propósito: si /cart.js o /cart/update.js fallan, seguimos igual
     * al add — es preferible un carrito sumado (el comportamiento viejo) a un botón
     * "Comprar" que no hace nada.
     */
    function limpiarLineasDelMenu() {
      return fetch("/cart.js", {
        credentials: "same-origin",
        headers: { Accept: "application/json" },
      })
        .then(function (res) {
          if (!res.ok) throw new Error("cart.js " + res.status);
          return res.json();
        })
        .then(function (cart) {
          var lineas = (cart && cart.items) || [];
          var updates = {};
          var hay = false;
          lineas.forEach(function (li) {
            var props = li && li.properties;
            if (props && props[MARCA_MENU] && li.key) {
              updates[li.key] = 0;
              hay = true;
            }
          });
          if (!hay) return null;
          return fetch("/cart/update.js", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ updates: updates }),
          }).then(function (res) {
            if (!res.ok) throw new Error("cart/update " + res.status);
            return res.json();
          });
        })
        .catch(function (err) {
          if (window.console) console.warn("[frutimenu-bridge] no pude limpiar lo anterior del menú", err);
          return null;
        });
    }

    function addToCart(items) {
      return fetch("/cart/add.js", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          items: items.map(function (i) {
            var props = {};
            props[MARCA_MENU] = "1";
            return { id: i.variantId, quantity: i.quantity, properties: props };
          }),
        }),
      }).then(function (res) {
        if (!res.ok) throw new Error("cart/add " + res.status);
        return res.json();
      });
    }

    // Best-effort: fija el código de descuento en el carrito (aplica en checkout).
    // El cupón igual viaja en el permalink del fallback, así que nunca bloquea.
    function applyDiscount(code) {
      if (!code) return Promise.resolve();
      return fetch("/discount/" + encodeURIComponent(code), { credentials: "same-origin" })
        .catch(function () { /* noop */ });
    }

    function openDrawer() {
      document.dispatchEvent(new CustomEvent("dispatch:cart-drawer:refresh"));
      document.dispatchEvent(new CustomEvent("dispatch:cart-drawer:open"));
    }

    window.addEventListener("message", function (e) {
      if (e.origin !== ALLOWED) return;
      var data = e.data;
      if (!data) return;

      // Reenvío de analítica del menú al pixel vivo del padre (744287072814737).
      // La app del iframe no tiene pixel propio; acá frutiferia.com sí. Solo eventos
      // custom no-PII. Respeta el consentimiento que ya gobierna el pixel del sitio.
      if (data.type === TRACK && typeof data.event === "string") {
        var p = data.params && typeof data.params === "object" ? data.params : {};
        try { if (typeof window.fbq === "function") window.fbq("trackCustom", data.event, p); } catch (err) { /* noop */ }
        try { if (typeof window.gtag === "function") window.gtag("event", data.event, p); } catch (err) { /* noop */ }
        return;
      }

      if (data.type !== REQUEST || !Array.isArray(data.items) || !data.items.length) return;

      // Saneo: solo variantId numérico y cantidad positiva (tope defensivo).
      var items = data.items
        .filter(function (i) { return i && /^\d+$/.test(String(i.variantId)) && i.quantity > 0; })
        .map(function (i) {
          return { variantId: String(i.variantId), quantity: Math.min(parseInt(i.quantity, 10) || 1, 99) };
        });
      if (!items.length) return;

      // Ack inmediato: "lo manejo nativo, no navegues". Frena el timeout de la app.
      // Ecoa el nonce del pedido (FM-4.1) para que la app sepa que es ESTE intento.
      ack(data.nonce);

      limpiarLineasDelMenu()
        .then(function () { return addToCart(items); })
        .then(function () { return applyDiscount(data.discount); })
        .then(openDrawer)
        .catch(function (err) {
          if (window.console) console.warn("[frutimenu-bridge] add falló, navego al fallback", err);
          // Mismo destino que el fallback de la app: /cart con los ítems + cupón.
          if (data.fallbackUrl) window.location.assign(data.fallbackUrl);
        });
    });
  })();
</script>
