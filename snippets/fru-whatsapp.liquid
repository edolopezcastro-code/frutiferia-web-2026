{%- comment -%}
  fru-whatsapp.liquid — FRUTI3-14.A: botón flotante de WhatsApp contextual.
  Mora (B2C, número por defecto) en toda la tienda; excepción de canal (regla
  dura del proyecto: B2B/Wellness → Francisco) en /pages/venta-a-negocios y
  /pages/bienestar. Mensaje pre-armado por contexto (PDP con el producto,
  carrito, genérico). Montado una sola vez, global, en layout/theme.liquid.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'fru-whatsapp.css' | asset_url }}">

{%- liquid
  assign fru_wa_to_francisco = false
  if request.page_type == 'page' and page.handle == 'venta-a-negocios'
    assign fru_wa_to_francisco = true
    assign fru_wa_text = 'Hola Francisco, quiero cotizar para mi negocio'
  elsif request.page_type == 'page' and page.handle == 'bienestar'
    assign fru_wa_to_francisco = true
    assign fru_wa_text = 'Hola Francisco, quiero cotizar para mi equipo'
  elsif request.page_type == 'product'
    assign fru_wa_text = 'Hola Mora, vi ' | append: product.title | append: ' 🍓'
  elsif request.page_type == 'cart'
    assign fru_wa_text = 'Hola Mora, tengo una duda con mi pedido'
  else
    assign fru_wa_text = 'Hola Mora 👋'
  endif

  if fru_wa_to_francisco
    assign fru_wa_phone = '56993261147'
    assign fru_wa_aria = 'Escríbele a Francisco por WhatsApp'
  else
    assign fru_wa_phone = '56966093891'
    assign fru_wa_aria = 'Escríbele a Mora por WhatsApp'
  endif

  # El sticky-atc-panel del PDP (templates/product.json: sticky_atc_panel=true,
  # sticky_atc_position=end-dock) vive fixed/bottom-0 anclado al mismo lado —
  # despejarlo para no taparlo ni quedar tapado (§5 del plan: "sin tapar el
  # sticky del carrito").
  assign fru_wa_clear_dock = false
  if request.page_type == 'product'
    assign fru_wa_clear_dock = true
  endif
-%}

<a
  href="https://wa.me/{{ fru_wa_phone }}?text={{ fru_wa_text | url_encode }}"
  class="fru-whatsapp-fab{% if fru_wa_clear_dock %} fru-whatsapp-fab--clear-dock{% endif %}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="{{ fru_wa_aria }}"
>
  {%- render 'icon-whatsapp' -%}
</a>
