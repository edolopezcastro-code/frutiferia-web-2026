{%- comment -%}
  fru-whatsapp.liquid — FRUTI3-14.A: botón flotante de WhatsApp contextual.
  Mora (B2C, número por defecto) en toda la tienda; excepción de canal (regla
  dura del proyecto: B2B/Wellness → Francisco) en la landing B2B (template
  suffix `b2b`, hoy /pages/proveedor-restaurantes), en /pages/bienestar y,
  CTA-10A, en CUALQUIER página cuando el cliente logueado trae tag de canal
  (mismo mapping que sections/main-account.liquid:51). El B2B por página se
  detecta por template_suffix, no por handle, para sobrevivir cambios de URL.
  Mensaje pre-armado por contexto (PDP con el producto, carrito, genérico).
  Montado una sola vez, global, en layout/theme.liquid.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'fru-whatsapp.css' | asset_url }}">

{%- liquid
  assign fru_wa_to_francisco = false
  if customer.tags contains 'b2b' or customer.tags contains 'b2g' or customer.tags contains 'wellness'
    assign fru_wa_to_francisco = true
  elsif request.page_type == 'page' and page.template_suffix == 'b2b'
    assign fru_wa_to_francisco = true
  elsif request.page_type == 'page' and page.handle == 'bienestar'
    assign fru_wa_to_francisco = true
  endif

  if fru_wa_to_francisco
    assign fru_wa_name = 'Francisco'
  else
    assign fru_wa_name = 'Mora'
  endif

  if request.page_type == 'page' and page.template_suffix == 'b2b'
    assign fru_wa_text = 'Hola Francisco, quiero cotizar para mi negocio'
  elsif request.page_type == 'page' and page.handle == 'bienestar'
    assign fru_wa_text = 'Hola Francisco, quiero cotizar para mi equipo'
  elsif request.page_type == 'product'
    assign fru_wa_text = 'Hola ' | append: fru_wa_name | append: ', vi ' | append: product.title | append: ' 🍓'
  elsif request.page_type == 'cart'
    assign fru_wa_text = 'Hola ' | append: fru_wa_name | append: ', tengo una duda con mi pedido'
  else
    assign fru_wa_text = 'Hola ' | append: fru_wa_name | append: ' 👋'
  endif

  if fru_wa_to_francisco
    assign fru_wa_phone = '56993261147'
    assign fru_wa_aria = 'Escríbele a Francisco por WhatsApp'
  else
    assign fru_wa_phone = '56966093891'
    assign fru_wa_aria = 'Escríbele a Mora por WhatsApp'
  endif

  # El sticky-atc-panel del PDP (templates/product.json: sticky_atc_panel=true,
  # sticky_atc_position=end-dock) vive fixed/bottom-0 anclado al mismo lado —
  # despejarlo para no taparlo ni quedar tapado (§5 del plan: "sin tapar el
  # sticky del carrito").
  assign fru_wa_clear_dock = false
  if request.page_type == 'product'
    assign fru_wa_clear_dock = true
  endif

  # BELLA-5: /cart estrena barra fija de pago (sólo móvil, .fru-cart-bar) —
  # el FAB tiene que subirse o la tapa. Clase aparte de --clear-dock porque
  # esa barra NO existe en escritorio: allá el FAB se queda abajo.
  assign fru_wa_clear_cart_bar = false
  if request.page_type == 'cart'
    assign fru_wa_clear_cart_bar = true
  endif
-%}

<a
  href="https://wa.me/{{ fru_wa_phone }}?text={{ fru_wa_text | url_encode }}"
  class="fru-whatsapp-fab{% if fru_wa_clear_dock %} fru-whatsapp-fab--clear-dock{% endif %}{% if fru_wa_clear_cart_bar %} fru-whatsapp-fab--clear-cart-bar{% endif %}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="{{ fru_wa_aria }}"
>
  {%- render 'icon-whatsapp' -%}
</a>
