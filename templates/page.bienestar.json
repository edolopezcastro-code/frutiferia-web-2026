    "faq_wellness": {
      "type": "faq",
      "blocks": {
        "cat_general": { "type": "category", "settings": { "text": "Programa de bienestar" } },
        "q_minimo": {
          "type": "question",
          "settings": {
            "icon": "box",
            "heading": "¿Desde cuántos colaboradores funciona?",
            "text": "<p>Armamos propuestas desde equipos pequeños. Cuéntanos cuántos son y lo adaptamos a tu realidad.</p>"
          }
        },
        "q_entrega": {
          "type": "question",
          "settings": {
            "icon": "truck",
            "heading": "¿Cómo se entregan las cajas?",
            "text": "<p>Despacho programado a tu oficina en días fijos. Tú no gestionas nada; nosotros coordinamos cada entrega.</p>"
          }
        },
        "q_charlas": {
          "type": "question",
          "settings": {
            "icon": "chat_bubble",
            "heading": "¿Las charlas de bienestar tienen costo aparte?",
            "text": "<p>Depende del plan. Las coordinamos según el tamaño de tu equipo y los objetivos que tengas. Lo conversamos en la propuesta.</p>"
          }
        },
        "q_factura": {
          "type": "question",
          "settings": {
            "icon": "credit_card",
            "heading": "¿Emiten factura?",
            "text": "<p>Sí, boleta y factura electrónica. Todo formal y en regla para tu empresa.</p>"
          }
        },
        "q_zonas": {
          "type": "question",
          "settings": {
            "icon": "map_pin",
            "heading": "¿A qué zonas llegan?",
            "text": "<p>Viña del Mar, Concón, Reñaca, Quilpué, Valparaíso y alrededores. Para otras zonas, consúltanos disponibilidad.</p>"
          }
        }
