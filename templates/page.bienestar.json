    "wellness_banner": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"container\"><div style=\"max-width:840px;margin:0 auto;padding:28px 26px;border-top:4px solid var(--pill-wellness);border-radius:var(--radius);background:color-mix(in srgb, var(--pill-wellness) 6%, var(--surface));text-align:center;\"><span style=\"display:inline-flex;align-items:center;gap:8px;font-size:0.8rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:color-mix(in srgb, var(--pill-wellness), var(--fru-tinta) 24%);\"><span style=\"width:9px;height:9px;border-radius:var(--radius-pill);background:var(--pill-wellness);display:inline-block;\"></span>Programa Wellness</span><p style=\"margin:12px auto 0;max-width:640px;color:var(--text-muted);\">Así llamamos a nuestro programa de bienestar corporativo: cajas de fruta fresca, charlas y datos para tu equipo. Cuéntanos de tu empresa y te armamos una propuesta en menos de 24 horas.</p></div></div>",
        "section_height": "small",
        "full_width": false,
        "dividers": "none",
        "prevent_animation": false
      }
    },
