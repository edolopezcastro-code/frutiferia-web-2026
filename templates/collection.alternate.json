{
  "sections": {
    "collection-banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_title": true,
        "show_product_count": true,
        "show_collection_description": true,
        "collection_title_size": "h1",
        "text_width": "wide",
        "text_align": "text-start",
        "text_position": "justify-center items-center",
        "show_image": true,
        "use_product_image": false,
        "collection_image": "1.77",
        "color_scheme": "2"
      }
    },
    "promo_b2b": {
      "type": "promo-strip",
      "blocks": {
        "heading_b2b": {
          "type": "heading",
          "settings": {
            "heading": "Compras por mayor",
            "heading_size": "h4",
            "show_on_mobile": true,
            "show_on_desktop": true
          }
        },
        "text_b2b": {
          "type": "text",
          "settings": {
            "text": "<p>Precios especiales para <strong>restaurantes, hoteles y empresas</strong>. Cotiza por WhatsApp.</p>",
            "enlarge_text": false,
            "show_on_mobile": true,
            "show_on_desktop": true
          }
        }
      },
      "block_order": ["heading_b2b", "text_b2b"],
      "settings": {
        "section_height": "small",
        "color_scheme": "2",
        "full_width": true,
        "dividers": "none",
        "prevent_animation": false
      }
    },
    "collection-products": {
      "type": "main-collection-products",
      "settings": {
        "products_per_page": 24,
        "card_size_mobile": "small",
        "card_size": "medium",
        "show_layout_toggle": true,
        "enable_filtering": true,
        "filters_open_lg": true,
        "stick_on_scroll": true,
        "show_filter_counts": true,
        "expand_filters": true,
        "max_filter_options": 7,
        "enable_sorting": true,
        "sort_first": true
      }
    },
    "b2b_cta": {
      "type": "media-with-text",
      "blocks": {
        "heading_cta": {
          "type": "heading",
          "settings": {
            "heading": "¿Necesitas un pedido personalizado?",
            "heading_size": "h3",
            "heading_h1": false
          }
        },
        "text_cta": {
          "type": "text",
          "settings": {
            "text": "<p>Armamos pedidos a medida para tu negocio. <strong>Despacho programado, facturación y precios preferenciales.</strong></p>",
            "enlarge_text": true
          }
        },
        "button_cta": {
          "type": "button",
          "settings": {
            "button_label": "Cotizar por WhatsApp",
            "button_link": "https://api.whatsapp.com/send?phone=+56995754109&text=Hola%20FrutiEquipo,%20necesito%20cotizar%20un%20pedido%20por%20mayor",
            "button_style": "btn btn--primary"
          }
        }
      },
      "block_order": ["heading_cta", "text_cta", "button_cta"],
      "settings": {
        "image": "shopify://shop_images/Frutiferia.png",
        "layout": "right",
        "image_fit": "contain",
        "media_width": 45,
        "media_scale": 100,
        "text_align": "text-start",
        "color_scheme": "1",
        "only_content_color_scheme": false
      }
    },
    "trust_b2b": {
      "type": "icons-with-text",
      "blocks": {
        "ic_vol": { "type": "item", "settings": { "icon": "box", "heading": "Precios por volumen", "text": "<p>Descuentos desde 10 kg</p>", "link": "" } },
        "ic_despacho": { "type": "item", "settings": { "icon": "truck", "heading": "Despacho programado", "text": "<p>Tú eliges el día</p>", "link": "" } },
        "ic_factura": { "type": "item", "settings": { "icon": "briefcase", "heading": "Facturación", "text": "<p>Boleta y factura</p>", "link": "" } },
        "ic_whatsapp": { "type": "item", "settings": { "icon": "chat_bubble", "heading": "Atención directa", "text": "<p>WhatsApp dedicado</p>", "link": "" } }
      },
      "block_order": ["ic_vol", "ic_despacho", "ic_factura", "ic_whatsapp"],
      "settings": {
        "heading": "Beneficios para tu negocio",
        "heading_align": "text-center",
        "icon_size": 36,
        "title_type_scale": "small",
        "text_type_scale": "small",
        "icon_position": "beside",
        "mobile_stack": true,
        "section_height": "small",
        "color_scheme": "3",
        "full_width": true,
        "dividers": "none",
        "prevent_animation": false
      }
    },
    "collection_list_b2b": {
      "type": "collection-list",
      "blocks": {
        "col_frutas": { "type": "collection", "settings": { "collection": "frutas-deliciosas" } },
        "col_verduras": { "type": "collection", "settings": { "collection": "verduras-frescas" } },
        "col_despensa": { "type": "collection", "settings": { "collection": "despensa" } },
        "col_frutipacks": { "type": "collection", "settings": { "collection": "frutipack" } }
      },
      "block_order": ["col_frutas", "col_verduras", "col_despensa", "col_frutipacks"],
      "settings": {
        "title": "También te puede interesar",
        "heading_align": "text-start",
        "button_label": "Ver todas",
        "button_link": "shopify://collections",
        "layout": "carousel",
        "card_size": "medium",
        "use_product_image": true,
        "circle_image": true,
        "show_border": true,
        "color_scheme": "none",
        "full_width": true
      }
    }
  },
  "order": [
    "collection-banner",
    "promo_b2b",
    "collection-products",
    "b2b_cta",
    "trust_b2b",
    "collection_list_b2b"
  ]
}
