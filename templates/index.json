    "faq_homepage": {
      "type": "faq",
      "blocks": {
        "cat_pedidos": {
          "type": "category",
          "settings": {
            "text": "Sobre tu pedido"
          }
        },
        "q_como_pedir": {
          "type": "question",
          "settings": {
            "icon": "question_mark",
            "heading": "¿Cómo hago un pedido?",
            "text": "<p>Elige tus productos en la tienda online, agrégalos al carrito y paga. También puedes pedir por WhatsApp al +56 9 9575 4109.</p>"
          }
        },
        "q_envio_gratis": {
          "type": "question",
          "settings": {
            "icon": "box",
            "heading": "¿Tienen envío gratis?",
            "text": "<p>Sí, el envío es gratis para pedidos sobre $30.000. Para montos menores, el costo varía según tu zona.</p>"
          }
        },
        "cat_entrega": {
          "type": "category",
          "settings": {
            "text": "Entrega"
          }
        },
        "q_zonas": {
          "type": "question",
          "settings": {
            "icon": "map_pin",
            "heading": "¿A qué zonas entregan?",
            "text": "<p>Viña del Mar, Reñaca, Concón, Quilpué, Valparaíso y alrededores. Consulta nuestra <a href=\"/pages/reparto\">página de repartos</a> para más detalles.</p>"
          }
        },
        "q_dias": {
          "type": "question",
          "settings": {
            "icon": "calendar",
            "heading": "¿Qué días entregan?",
            "text": "<p>Martes, miércoles, viernes y sábados. El día depende de tu zona de entrega.</p>"
          }
        },
        "cat_calidad": {
          "type": "category",
          "settings": {
            "text": "Calidad"
          }
        },
        "q_frescura": {
          "type": "question",
          "settings": {
            "icon": "leaf",
            "heading": "¿Cómo garantizan la frescura?",
            "text": "<p>Seleccionamos cada producto a mano. Si algo no cumple tus expectativas, contáctanos y lo resolvemos.</p>"
          }
        }
      },
