    "testimonials_JERNA6": {
      "type": "testimonials",
      "blocks": {
        "review_carolina": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Excelente experiencia. Productos frescos, que duran. Muy fácil para elegir, pagar y solicitar reparto. 10/10.</p>",
            "author": "Carolina Espíndola Patterson",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "review_magdalena": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Me encanta Frutiferia!! Es el único lugar donde escogen las frutas y verduras como si uno fuera a la feria o al súper. Excelente calidad siempre, precios convenientes y con un sello de amor por el trabajo maravillosooo. Me encantan y los recomiendo a miiil!!!</p>",
            "author": "Magdalena López",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "review_beatriz": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Siempre pido la fruta y verdura a Frutiferia por la comodidad de que llegue a tu casa, exactamente lo que pediste y en el horario convenido, me gusta también que siempre venga todo ordenado y protegido, se mueren además lo rico que es todo, especialmente las frutillas, que es mi fruta favorita!!!</p>",
            "author": "Beatriz Barry",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "review_washington": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Frutiferia es eso que jamás pensé que iba a tener en una frutería, calidad, precio y buenísima experiencia al cliente. Los conocí hace unos años y son mis mejores amigos hoy, aunque no nos conocemos.</p>",
            "author": "Washington Maturana C.",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "review_rocio": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Estupendo todo! la atención, la calidad de las frutas y verduras, excelentes los productos de pymes (como la mantequilla de maní!!) súper recomendado</p>",
            "author": "Rocío Álvarez Tapia",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "review_paula": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>La fruta y verdura fresca y exquisita! El servicio excelente. 10/10. 100% recomendado</p>",
            "author": "Paula Arismendi",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "review_solange": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Excelentes productos, sin duda volveré a pedir mis frutas y verduras con ellos</p>",
            "author": "Solange Paola Ramírez Valenzuela",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "review_luz": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Excelente lugar atendido por sus dueños. Las verduras y frutas son de excelente calidad. Somos clientes por muchos años.</p>",
            "author": "Luz Castro",
            "author_info": "Reseña de Google",
            "show_star_rating": true,
            "star_rating": 5
          }
        }
      },
